# Salin ke .env lalu sesuaikan.
# Port PostgreSQL: instance 18 default 5432, instance 14 default 5433.
# Cek port dengan: Get-NetTCPConnection -State Listen -LocalPort 5432,5433
DATABASE_URL=postgres://pos_hakim:pos_hakim_dev@127.0.0.1:5433/pos_hakim
TEST_DATABASE_URL=postgres://pos_hakim:pos_hakim_dev@127.0.0.1:5433/pos_hakim_test

PORT=3000
TZ=Asia/Jakarta

# Umur token login (jam). Default 720 = 30 hari.
TOKEN_TTL_HOURS=720
